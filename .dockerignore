.idea/
.superpowers/
output/
documents/
portfolio/
scratch/
reports/
gmail_sync/
company_research/*.json
candidate_config.local.json
**/*.local.md
.claude/settings.local.json
.claude/projects/
salary_data.json
job_search_tracker.csv
cv/main_*.*
!cv/main_example.tex
cover_letters/cover_*.*
cover_letters/Cover_*.*
